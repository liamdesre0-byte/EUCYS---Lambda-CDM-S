# Bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Solver / MCMC outputs (regenerate locally)
theory_export/
lcdms_validation_out/
results/
figures/*.png
figures/*.pdf
figures/generated_captions.md
*.lprof

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Secrets (none expected; keep the pattern)
.env
.env.*
credentials.json
*.pem

# Large local data (do not commit survey catalogs)
data/*.fits
data/*.tar
data/*.gz
!data/README.md
# Compressed inference vectors ARE committed (small, public survey data):
# pantheon_plus.csv, des_sny5.csv, shoes_h0.csv
!data/pantheon_plus.csv
!data/des_sny5.csv
!data/shoes_h0.csv

# Generated artifacts: small outputs are committed for presentation;
# archive full production chains (>50 MB) on Zenodo/OSF instead of git.
output/**/*.mmap
output/**/*.npz
